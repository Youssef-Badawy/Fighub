rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && (
                      request.resource.data.sellerId == request.auth.uid
                      || (
                        request.resource.data.productType == 'print_order'
                        && request.resource.data.buyerId == request.auth.uid
                        && request.resource.data.reservedBy == request.auth.uid
                        && request.resource.data.status == 'Reserved'
                        && request.resource.data.sourcePrintProductId is string
                        && exists(
                          /databases/$(database)/documents/print_products/$(request.resource.data.sourcePrintProductId)
                        )
                        && get(
                          /databases/$(database)/documents/print_products/$(request.resource.data.sourcePrintProductId)
                        ).data.sellerId == request.resource.data.sellerId
                        && getAfter(
                          /databases/$(database)/documents/print_products/$(request.resource.data.sourcePrintProductId)
                        ).data.stockQuantity
                           == get(
                             /databases/$(database)/documents/print_products/$(request.resource.data.sourcePrintProductId)
                           ).data.stockQuantity - 1
                      )
                    );

      allow update: if request.auth != null
                    && (
                      (
                        resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId
                           == resource.data.sellerId
                        && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['createdAt'])
                      )
                      ||
                      (
                        request.auth.uid != resource.data.sellerId
                        && resource.data.status == 'Available'
                        && (
                          !resource.data.keys().hasAny(['reservedBy'])
                          || resource.data.reservedBy == null
                          || resource.data.reservedBy == ''
                        )
                        && request.resource.data.status == 'Reserved'
                        && request.resource.data.reservedBy
                           == request.auth.uid
                        && request.resource.data.sellerId
                           == resource.data.sellerId
                        && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['status', 'reservedBy', 'reservedAt'])
                      )
                      ||
                      (
                        request.auth.uid != resource.data.sellerId
                        && resource.data.status == 'Reserved'
                        && resource.data.reservedBy == request.auth.uid
                        && request.resource.data.status == 'Available'
                        && request.resource.data.reservedBy == null
                        && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['status', 'reservedBy', 'reservedAt'])
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid
                    && resource.data.get('status', 'Available') == 'Available';
    }

    match /app_config/{configId} {
      allow get: if request.auth != null && configId == 'shipping';
      allow list: if false;

      allow create, update: if request.auth != null
                            && configId == 'shipping'
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                            && request.resource.data.keys().hasOnly(['whatsappNumber'])
                            && request.resource.data.whatsappNumber is string
                            && request.resource.data.whatsappNumber.matches('^[0-9]{10,15}$');

      allow delete: if false;
    }

    match /users/{userId} {

      allow read: if request.auth != null
                    && request.auth.uid == userId;

      allow create: if request.auth != null
                      && request.auth.uid == userId
                      && (
                        !request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role == 'user'
                      );

      allow update: if request.auth != null
                      && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['role']);

      allow delete: if false;

      match /favorites/{favoriteId} {

        allow read: if request.auth != null
                      && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.productId == favoriteId;

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.productId == favoriteId;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {

        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.resource.data.title is string
                      && request.resource.data.message is string
                      && request.resource.data.isRead == false
                      && (
                        (
                          request.resource.data.chatId is string
                          && exists(
                            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
                          )
                          && request.auth.uid in get(
                            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
                          ).data.participants
                          && userId in get(
                            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
                          ).data.participants
                        )
                        ||
                        exists(
                          /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
                        )
                      );

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['isRead']);

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      match /following/{followingUserId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.userId
                         == followingUserId;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;

        allow update: if false;
      }

      match /followers/{followerUserId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.auth.uid == followerUserId
                      && request.resource.data.userId
                         == followerUserId;

        allow delete: if request.auth != null
                      && request.auth.uid == followerUserId;

        allow update: if false;
      }
    }


    match /seller_profiles/{sellerId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == sellerId;

      allow update: if request.auth != null
                    && request.auth.uid == sellerId;

      allow delete: if false;
    }

    match /offers/{offerId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.sellerId
                       == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.sellerId
                       == request.auth.uid
                    && request.resource.data.sellerId
                       == resource.data.sellerId;

      allow delete: if request.auth != null
                    && resource.data.sellerId
                       == request.auth.uid;

      match /items/{itemId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && get(
                        /databases/$(database)/documents/offers/$(offerId)
                      ).data.sellerId
                         == request.auth.uid;

        allow update: if request.auth != null
                      && (
                        (
                          get(
                            /databases/$(database)/documents/offers/$(offerId)
                          ).data.sellerId == request.auth.uid
                          && resource.data.status == 'Reserved'
                          && resource.data.reservedBy is string
                          && request.resource.data.status == 'Sold'
                          && request.resource.data.soldTo
                             == resource.data.reservedBy
                          && request.resource.data.soldAt == request.time
                          && getAfter(
                            /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(resource.data.reservedBy)
                          ).data.userId == resource.data.reservedBy
                          && getAfter(
                            /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(resource.data.reservedBy)
                          ).data.status == 'Settled'
                          && getAfter(
                            /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(resource.data.reservedBy)
                          ).data.settledAt == request.time
                          && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['status', 'soldTo', 'soldAt'])
                        )
                        ||
                        (
                          resource.data.reservedBy
                             == request.auth.uid
                          && request.resource.data.reservedBy
                             == null
                          && request.resource.data.status
                             == 'Available'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'status',
                               'reservedBy',
                               'reservedAt',
                               'waitingUsers'
                             ])
                        )
                        ||
                        (
                          get(
                            /databases/$(database)/documents/offers/$(offerId)
                          ).data.get('isDeleted', false) != true
                          && resource.data.status
                             == 'Available'
                          && resource.data.reservedBy
                             == null
                          && request.resource.data.status
                             == 'Reserved'
                          && request.resource.data.reservedBy
                             == request.auth.uid
                          && (
                            (
                              resource.data.get('waitingUsers', []).size() == 0
                              && request.resource.data.get('waitingUsers', []).size() == 0
                            )
                            ||
                            (
                              resource.data.get('waitingUsers', []).size() > 0
                              && resource.data.waitingUsers[0] == request.auth.uid
                              && request.resource.data.get('waitingUsers', []).size()
                                 == resource.data.waitingUsers.size() - 1
                            )
                          )
                          && getAfter(
                               /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(request.auth.uid)
                             ).data.userId
                             == request.auth.uid
                          && getAfter(
                               /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(request.auth.uid)
                             ).data.status
                             == 'Active'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'status',
                               'reservedBy',
                               'reservedAt',
                               'waitingUsers'
                             ])
                        )

                        ||
                        (
                          get(
                            /databases/$(database)/documents/offers/$(offerId)
                          ).data.get('isDeleted', false) != true
                          && resource.data.status
                             == 'Reserved'
                          && resource.data.reservedBy
                             != null
                          && request.resource.data.status
                             == 'Reserved'
                          && request.resource.data.reservedBy
                             == resource.data.reservedBy
                          && request.resource.data.get('waitingUsers', []).size()
                             == resource.data.get('waitingUsers', []).size() + 1
                          && request.resource.data.get('waitingUsers', [])[
                               resource.data.get('waitingUsers', []).size()
                             ]
                             == request.auth.uid
                          && getAfter(
                               /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(request.auth.uid)
                             ).data.userId
                             == request.auth.uid
                          && getAfter(
                               /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)/reservations/$(request.auth.uid)
                             ).data.status
                             == 'Waiting'
                          && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'waitingUsers'
                             ])
                        )
                      );

        allow delete: if request.auth != null
                      && get(
                        /databases/$(database)/documents/offers/$(offerId)
                      ).data.sellerId == request.auth.uid
                      && (
                        get(
                          /databases/$(database)/documents/offers/$(offerId)
                        ).data.get('isDeleted', false) == true
                        ||
                        (
                          resource.data.status == 'Available'
                          && resource.data.get('waitingUsers', []).size() == 0
                        )
                      );

        match /reservations/{reservationId} {

          allow read: if request.auth != null
                      && (
                        request.auth.uid == reservationId
                        ||
                        get(
                          /databases/$(database)/documents/offers/$(offerId)
                        ).data.sellerId
                           == request.auth.uid
                      );

          allow create: if request.auth != null
                        && request.auth.uid == reservationId
                        && request.resource.data.userId
                           == request.auth.uid
                        && get(
                          /databases/$(database)/documents/offers/$(offerId)
                        ).data.get('isDeleted', false) != true
                        && (
                          request.resource.data.status
                             == 'Active'
                          ||
                          request.resource.data.status
                             == 'Waiting'
                        );

          allow update: if request.auth != null
                        && (
                          (
                            request.auth.uid == reservationId
                            && resource.data.userId == request.auth.uid
                            && request.resource.data.userId == request.auth.uid
                            && (
                              (
                                resource.data.status == 'Waiting'
                                && request.resource.data.status == 'Active'
                                && request.resource.data.cancelledAt == null
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.status == 'Reserved'
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.reservedBy == request.auth.uid
                                && request.resource.data.diff(resource.data)
                                   .affectedKeys().hasOnly(['status', 'cancelledAt'])
                              )
                              ||
                              (
                                resource.data.status == 'Cancelled'
                                && request.resource.data.status == 'Active'
                                && resource.data.userId == request.auth.uid
                                && request.resource.data.userId == request.auth.uid
                                && request.resource.data.cancelledAt == null
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.status == 'Reserved'
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.reservedBy == request.auth.uid
                                && request.resource.data.diff(resource.data)
                                   .affectedKeys()
                                   .hasOnly(['status', 'cancelledAt', 'createdAt'])
                              )
                              ||
                              (
                                resource.data.status == 'Cancelled'
                                && request.resource.data.status == 'Waiting'
                                && resource.data.userId == request.auth.uid
                                && request.resource.data.userId == request.auth.uid
                                && request.resource.data.cancelledAt == null
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.status == 'Reserved'
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.reservedBy != request.auth.uid
                                && request.auth.uid in getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.waitingUsers
                                && request.resource.data.diff(resource.data)
                                   .affectedKeys()
                                   .hasOnly(['status', 'cancelledAt', 'createdAt'])
                              )
                              ||
                              (
                                resource.data.status == 'Active'
                                && request.resource.data.status == 'Cancelled'
                                && request.resource.data.cancelledAt == request.time
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.status == 'Available'
                                && getAfter(
                                  /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                                ).data.reservedBy == null
                                && request.resource.data.diff(resource.data)
                                   .affectedKeys().hasOnly(['status', 'cancelledAt'])
                              )
                            )
                          )
                          ||
                          (
                            get(
                              /databases/$(database)/documents/offers/$(offerId)
                            ).data.sellerId == request.auth.uid
                            && resource.data.status == 'Active'
                            && request.resource.data.status == 'Settled'
                            && request.resource.data.userId == resource.data.userId
                            && request.resource.data.settledAt == request.time
                            && getAfter(
                              /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                            ).data.status == 'Sold'
                            && getAfter(
                              /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                            ).data.soldTo == resource.data.userId
                            && getAfter(
                              /databases/$(database)/documents/offers/$(offerId)/items/$(itemId)
                            ).data.soldAt == request.time
                            && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status', 'settledAt'])
                          )
                        );

          allow delete: if request.auth != null
                        && get(
                          /databases/$(database)/documents/offers/$(offerId)
                        ).data.sellerId == request.auth.uid
                        && (
                          get(
                            /databases/$(database)/documents/offers/$(offerId)
                          ).data.get('isDeleted', false) == true
                          || resource.data.status == 'Cancelled'
                        );
        }
      }
    }

    match /verification_requests/{requestId} {

      allow read: if request.auth != null
                  && (
                    resource.data.userId == request.auth.uid
                    ||
                    get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.role == 'admin'
                  );

      allow create: if request.auth != null
                    && request.resource.data.userId
                       == request.auth.uid
                    && request.resource.data.planId is string
                    && (
                      request.resource.data.planId
                        == 'monthly'
                      ||
                      request.resource.data.planId
                        == 'three_months'
                    )
                    && request.resource.data.amount is int
                    && (
                      (
                        request.resource.data.planId
                          == 'monthly'
                        &&
                        request.resource.data.amount
                          == 100
                      )
                      ||
                      (
                        request.resource.data.planId
                          == 'three_months'
                        &&
                        request.resource.data.amount
                          == 200
                      )
                    )
                    && request.resource.data.durationMonths
                       is int
                    && (
                      (
                        request.resource.data.planId
                          == 'monthly'
                        &&
                        request.resource.data.durationMonths
                          == 1
                      )
                      ||
                      (
                        request.resource.data.planId
                          == 'three_months'
                        &&
                        request.resource.data.durationMonths
                          == 3
                      )
                    )
                    && request.resource.data.status
                       == 'Pending'
                    && request.resource.data.paymentProofUrl
                       is string
                    && request.resource.data.paymentProofUrl
                       != ''
                    && request.resource.data.rejectionReason
                       == ''
                    && request.resource.data.reviewedAt
                       == null
                    && request.resource.data.startsAt
                       == null
                    && request.resource.data.expiresAt
                       == null;

      allow update: if request.auth != null
                    && get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.role == 'admin'
                    && request.resource.data.userId
                       == resource.data.userId;

      allow delete: if false;
    }

    match /print_businesses/{businessId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == businessId
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid == businessId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['name', 'phone', 'description', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /print_products/{printProductId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/print_businesses/$(request.auth.uid)
                    );
      allow update: if request.auth != null
                    && (
                      (
                        resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == resource.data.sellerId
                        && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly([
                             'name', 'price', 'stockQuantity', 'category',
                             'description', 'imageUrl', 'active', 'updatedAt'
                           ])
                        && request.resource.data.stockQuantity is int
                        && request.resource.data.stockQuantity >= 0
                      )
                      || (
                        request.auth.uid != resource.data.sellerId
                        && resource.data.active == true
                        && resource.data.stockQuantity is int
                        && resource.data.stockQuantity > 0
                        && request.resource.data.stockQuantity
                           == resource.data.stockQuantity - 1
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
                      )
                    );
      allow delete: if false;
    }

    match /print_design_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.companyId is string
                    && exists(
                      /databases/$(database)/documents/print_businesses/$(request.resource.data.companyId)
                    )
                    && request.resource.data.status == 'new'
                    && request.resource.data.category is string
                    && request.resource.data.imageUrl is string
                    && request.resource.data.imageUrl.size() > 0;
      allow read: if request.auth != null
                  && (
                    resource.data.customerId == request.auth.uid
                    || resource.data.companyId == request.auth.uid
                  );
      allow update: if request.auth != null
                    && resource.data.companyId == request.auth.uid
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['in_progress', 'completed'];
      allow delete: if false;
    }

    match /chats/{chatId} {

      allow get: if request.auth != null
                 && (
                   !exists(
                     /databases/$(database)/documents/chats/$(chatId)
                   )
                   || request.auth.uid in resource.data.participants
                 );

      allow list: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
                    && request.resource.data.buyerId is string
                    && request.resource.data.sellerId is string
                    && request.resource.data.buyerId
                       != request.resource.data.sellerId
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid
                       in request.resource.data.participants
                    && request.resource.data.participants.hasAll([
                      request.resource.data.buyerId,
                      request.resource.data.sellerId
                    ]);

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'offerItems',
                           'settlementBuyerConfirmed',
                           'settlementSellerConfirmed',
                           'settledOrders',
                           'updatedAt',
                           'lastMessage',
                           'clearedAt',
                           'lastReadBy'
                         ])
                    && (
                      !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['settlementBuyerConfirmed'])
                      || (
                        request.resource.data.settlementBuyerConfirmed is bool
                        && (
                          request.resource.data.settlementBuyerConfirmed != true
                          || request.auth.uid == resource.data.buyerId
                        )
                      )
                    )
                    && (
                      !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['settlementSellerConfirmed'])
                      || (
                        request.resource.data.settlementSellerConfirmed is bool
                        && (
                          request.resource.data.settlementSellerConfirmed != true
                          || request.auth.uid == resource.data.sellerId
                        )
                      )
                    )
                    && (
                      !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['settledOrders'])
                      || (
                        request.auth.uid == resource.data.sellerId
                        && request.resource.data.settledOrders is list
                        && request.resource.data.settledOrders.size()
                           == resource.data.get('settledOrders', []).size() + 1
                      )
                    )
                    && (
                      !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['clearedAt'])
                      || (
                        'clearedAt' in request.resource.data
                        && request.resource.data.clearedAt is map
                        && (
                          !('clearedAt' in resource.data)
                          ? request.resource.data.clearedAt.keys()
                              .hasOnly([request.auth.uid])
                          : request.resource.data.clearedAt.diff(
                              resource.data.clearedAt
                            ).affectedKeys().hasOnly([request.auth.uid])
                        )
                        && request.resource.data.clearedAt.get(
                             request.auth.uid, null
                           ) == request.time
                      )
                    )
                    && (
                      !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['lastReadBy'])
                      || (
                        'lastReadBy' in request.resource.data
                        && request.resource.data.lastReadBy is map
                        && (
                          !('lastReadBy' in resource.data)
                          ? request.resource.data.lastReadBy.keys()
                              .hasOnly([request.auth.uid])
                          : request.resource.data.lastReadBy.diff(
                              resource.data.lastReadBy
                            ).affectedKeys().hasOnly([request.auth.uid])
                        )
                        && request.resource.data.lastReadBy.get(
                             request.auth.uid, null
                           ) == request.time
                      )
                    );

      allow delete: if false;

      match /messages/{messageId} {

        allow read: if request.auth != null
                    && request.auth.uid in
                       get(
                         /databases/$(database)/documents/chats/$(chatId)
                       ).data.participants;

        allow create: if request.auth != null
                      && request.auth.uid in
                         get(
                           /databases/$(database)/documents/chats/$(chatId)
                         ).data.participants
                      && request.resource.data.senderId
                         == request.auth.uid;

        allow update: if false;

        allow delete: if request.auth != null
                      && request.auth.uid in
                         get(
                           /databases/$(database)/documents/chats/$(chatId)
                         ).data.participants
                      && resource.data.senderId == request.auth.uid;
      }
    }
  }
}